{
  "name": "trpg-toolkit-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TRPG Toolkit 新框架：共用元件、核心模組與各工具頁面",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "http-server .. -p 8123 -c-1",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run build && playwright test",
    "e2e:update": "npm run build && playwright test --update-snapshots=all",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "parity:text-fx": "playwright test -c tests/parity/text-fx/playwright.config.ts",
    "parity:text-fx:report": "node --experimental-strip-types tests/parity/text-fx/report.ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "ag-psd": "^31.0.2",
    "comlink": "^4.4.2",
    "dompurify": "^3.4.16",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "idb-keyval": "^6.3.0",
    "immer": "^11.1.18",
    "lucide-react": "^1.49.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zundo": "^2.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "http-server": "^14.1.1",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
